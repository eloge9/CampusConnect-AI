APP_NAME=CampusConnect AI
ENVIRONMENT=development
DEBUG=True
DATABASE_URL=postgresql+psycopg2://campusconnect_user:changeme@localhost:5432/campusconnect

JWT_SECRET_KEY=changeme-generate-a-random-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

SEED_ADMIN_EMAIL=admin@campusconnect.dev
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_TEACHER_EMAIL=enseignant@campusconnect.dev
SEED_TEACHER_PASSWORD=TeacherDemo123!
SEED_STUDENT_EMAIL=etudiant@campusconnect.dev
SEED_STUDENT_PASSWORD=StudentDemo123!

# "*" en développement, ou une liste séparée par des virgules en production :
# CORS_ALLOWED_ORIGINS=https://campusconnect-web.app,https://admin.campusconnect-web.app
CORS_ALLOWED_ORIGINS=*

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png
